# =============================================================================
# Agenda Pro — variáveis de ambiente (copie para .env e preencha)
# Nunca commite o arquivo .env com segredos reais.
# =============================================================================

# --- Infra local (docker compose) ---
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_secret
POSTGRES_DB=agenda_pro
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://agenda:agenda_secret@localhost:5432/agenda_pro?schema=public

# Redis (BullMQ — usado a partir da Fase 4)
REDIS_URL=redis://localhost:6379

# JWT (gere valores longos e aleatórios em produção)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — origem do frontend Next.js
CORS_ORIGIN=http://localhost:3000

# App / links públicos
APP_NAME=Agenda Pro
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Logging
LOG_LEVEL=info

# Planos — preços em centavos (placeholders; valide com clientes reais)
# Não são cobrados na Fase 1; a estrutura já fica pronta.
PLAN_STARTER_PRICE_CENTS=0
PLAN_PRO_PRICE_CENTS=4990
PLAN_BUSINESS_PRICE_CENTS=9990

# Stripe (Fase 7 — deixe vazio no MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# E-mail (Fase 4 — deixe vazio até configurar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Agenda Pro <noreply@agendapro.local>"

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
