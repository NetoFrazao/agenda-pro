# =============================================================================
# Agenda Pro — variáveis de ambiente (copie para .env e preencha)
# Nunca commite o arquivo .env com segredos reais.
# =============================================================================

# --- Infra local (docker compose) ---
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_secret
POSTGRES_DB=agenda_pro
POSTGRES_PORT=5432
REDIS_PORT=6379
# Compose prod (docker-compose.prod.yml): obrigatório. Dev compose NÃO usa AUTH.
# Gere URL-safe (hex): openssl rand -hex 32 — não use placeholder tipo "redis"/"password".
REDIS_PASSWORD=

# --- API ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# PostgreSQL (Prisma)
# connection_limit = tamanho do pool Prisma (ajuste sob carga; default Prisma ~num_cpus*2+1)
DATABASE_CONNECTION_LIMIT=10
DATABASE_URL=postgresql://agenda:agenda_secret@localhost:5432/agenda_pro?schema=public&connection_limit=10

# Redis (BullMQ + cache curto de perfil/slots públicos)
# Dev: sem senha. Prod compose monta redis://:${REDIS_PASSWORD}@redis:6379 automaticamente.
REDIS_URL=redis://localhost:6379

# Processo: all (default, HTTP+worker no mesmo processo) | api | worker
# Compose prod: api=PROCESS_ROLE=api + serviço worker=PROCESS_ROLE=worker
# PROCESS_ROLE=all

# Health / ops
# GET /api/health = liveness (PG); GET /api/health/ready = PG + Redis (503 se down)
# Monitoramento: scripts/watch-ready.ps1 + .github/workflows/health-probe.yml
HEALTH_READY_URL=http://localhost:3001/api/health/ready
HEALTH_ALERT_WEBHOOK_URL=

# Backup off-host (cópia após pg_dump). Ex.: pasta sync OneDrive/S3 mount
BACKUP_OFFHOST_DIR=
# Alerta em falha de backup (fallback: HEALTH_ALERT_WEBHOOK_URL)
BACKUP_ALERT_WEBHOOK_URL=

# TLS (docker-compose.tls.yml + Caddy). Breaking: remove host :3000/:3001.
# TLS_DOMAIN=app.example.com
# CADDY_EMAIL=ops@example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# CD / imagens (scripts/deploy-release.sh)
# API_IMAGE=ghcr.io/org/agenda-pro-api:sha-…
# WEB_IMAGE=ghcr.io/org/agenda-pro-web:sha-…

# Sentry (SDK ainda não no app — ver docs/ops/SENTRY.md)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=

# JWT (gere valores longos e aleatórios em produção)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — origem do frontend Next.js
CORS_ORIGIN=http://localhost:3000

# App / links públicos
APP_NAME=Agenda Pro
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Logging
LOG_LEVEL=info

# Planos — preços em centavos (placeholders; valide com clientes reais)
# Não são cobrados na Fase 1; a estrutura já fica pronta.
PLAN_STARTER_PRICE_CENTS=0
PLAN_PRO_PRICE_CENTS=4990
PLAN_BUSINESS_PRICE_CENTS=9990

# Stripe (billing SaaS). Em produção, obrigatório para upgrade PRO/BUSINESS.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Só em development/test: permite ativar plano pago sem Stripe (local_demo). Ignorado em production.
ALLOW_BILLING_DEMO=false

# E-mail (Fase 4 — deixe vazio até configurar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Agenda Pro <noreply@agendapro.local>"

# Swagger em produção (fora de produção fica sempre ligado)
SWAGGER_ENABLED=false

# WhatsApp real via Evolution API (self-hosted). Vazio = modo link wa.me
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Sinal via PIX (Mercado Pago). Vazio = sinal combinado "no local"
MERCADOPAGO_ACCESS_TOKEN=
# Secret do webhook (painel MP → Webhooks → Assinatura secreta). Obrigatório em produção.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
