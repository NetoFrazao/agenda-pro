{
  "name": "agenda-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Mini-SaaS de agendamentos inteligentes para barbeiros e manicures",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @agenda-pro/api",
    "dev:web": "npm run dev -w @agenda-pro/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @agenda-pro/api",
    "db:generate": "npm run prisma:generate -w @agenda-pro/api",
    "db:migrate": "npm run prisma:migrate -w @agenda-pro/api",
    "db:migrate:dev": "npm run prisma:migrate:dev -w @agenda-pro/api",
    "db:studio": "npm run prisma:studio -w @agenda-pro/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
