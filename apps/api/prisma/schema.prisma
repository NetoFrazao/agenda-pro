// =============================================================================
// Agenda Pro — Schema Prisma (Fase 1)
//
// Decisões principais:
// - Multi-tenant por Tenant: todo dado de negócio carrega tenantId.
// - Datas de agendamento em UTC (DateTime); fuso fica em Tenant/User.
// - Preço do serviço é por Tenant (centavos), sem tabela global de preços.
// - Planos com preços via env no app; aqui só a estrutura de limites/features.
// - Anti double-booking: unique (professionalId, startsAt); overlap na Fase 3.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Conta do negócio (barbeiro autônomo, manicure ou pequeno salão).
/// Isolamento multi-tenant começa aqui: queries de negócio SEMPRE filtram por tenantId.
model Tenant {
  id        String   @id @default(cuid())
  /// Slug público da página de agendamento: /u/{slug}
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(120)
  /// IANA timezone do estabelecimento (ex: America/Sao_Paulo)
  timezone  String   @default("America/Sao_Paulo") @db.VarChar(64)
  /// Plano comercial atual (free no MVP até Fase 7)
  plan      PlanCode @default(STARTER)

  // ---- Perfil público (página /u/{slug}) ----
  about    String? @db.VarChar(500)
  address  String? @db.VarChar(255)
  /// WhatsApp do estabelecimento (exibido na página pública)
  whatsapp String? @db.VarChar(32)

  // ---- Regras de agendamento (padrões de mercado: Booksy/Trinks) ----
  /// Antecedência mínima para agendar (minutos). Ex: 60 = só a partir de 1h antes.
  minNoticeMinutes Int @default(60)
  /// Janela máxima de agendamento futuro (dias)
  maxAdvanceDays   Int @default(60)
  /// Intervalo obrigatório entre atendimentos (minutos)
  bufferMinutes    Int @default(0)
  /// Grade de horários exibida ao cliente (minutos). 15 = 09:00, 09:15, 09:30...
  slotGridMinutes  Int @default(15)
  /// Prazo mínimo p/ cliente cancelar sozinho (horas antes do horário)
  cancelMinHours   Int @default(2)

  // ---- Fidelidade (P2) ----
  loyaltyEnabled       Boolean @default(false)
  /// Pontos ganhos por real gasto em atendimento concluído
  loyaltyPointsPerReal Int     @default(1)

  /// Soft-delete / LGPD: marca exclusão sem apagar auditoria imediata
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  services      Service[]
  availability  AvailabilityRule[]
  exceptions    AvailabilityException[]
  clients       Client[]
  appointments  Appointment[]
  subscription  Subscription?
  waitlist      WaitlistEntry[]
  reviews       Review[]
  pixCharges    PixCharge[]

  @@map("tenants")
}

enum PlanCode {
  STARTER
  PRO
  BUSINESS
}

enum UserRole {
  OWNER
  MEMBER
}

/// Profissional (login do dashboard). No MVP 1:1 com Tenant; schema já permite N profissionais.
model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @db.VarChar(255)
  passwordHash String
  name         String    @db.VarChar(120)
  phone        String?   @db.VarChar(32)
  role         UserRole  @default(OWNER)
  /// Fuso preferido na UI (pode diferir do Tenant, ex: dono viajando)
  timezone     String?   @db.VarChar(64)
  /// Comissão do profissional sobre atendimentos concluídos (0–100%)
  commissionPercent Int  @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  availabilityRules   AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Refresh tokens rotativos (Fase 2). Modelados já na Fase 1 para evitar migration dolorosa.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// Hash do token (nunca armazenar o JWT/refresh em texto puro)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Token de reset de senha (uso único, expira em 1h). Armazenado como hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Serviço oferecido pelo profissional — preço e duração definidos por conta.
model Service {
  id              String    @id @default(cuid())
  tenantId        String
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(500)
  /// Duração em minutos (ex: 30, 45, 60)
  durationMinutes Int
  /// Preço em centavos BRL (ex: R$ 45,00 => 4500). Sem preço global do sistema.
  priceCents      Int
  /// Sinal/depósito opcional (Fase 7 / bônus). 0 = não exige.
  depositCents    Int       @default(0)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId, isActive])
  @@map("services")
}

/// Regra recorrente de disponibilidade (ex: Seg–Sex 09:00–18:00).
/// startTime/endTime são "horário de parede" no timezone do Tenant (não UTC).
model AvailabilityRule {
  id              String @id @default(cuid())
  tenantId        String
  /// Profissional específico; null = aplica a todos do tenant (MVP usa o OWNER)
  professionalId  String?
  /// 0 = Domingo ... 6 = Sábado (mesmo convencionado do JS Date.getDay())
  dayOfWeek       Int
  /// Minutos desde meia-noite local (ex: 09:00 => 540)
  startMinute     Int
  /// Minutos desde meia-noite local (ex: 18:00 => 1080). Deve ser > startMinute.
  endMinute       Int
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional User?  @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, dayOfWeek, isActive])
  @@index([professionalId])
  @@map("availability_rules")
}

/// Exceção pontual: folga, feriado ou horário especial em uma data.
model AvailabilityException {
  id             String   @id @default(cuid())
  tenantId       String
  professionalId String?
  /// Data civil no timezone do tenant (armazenada como date, sem hora)
  date           DateTime @db.Date
  /// false = dia inteiro bloqueado; true = janela especial (usa start/end)
  isAvailable    Boolean  @default(false)
  startMinute    Int?
  endMinute      Int?
  reason         String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional User?  @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([professionalId, date])
  @@map("availability_exceptions")
}

/// Cliente final (titular de dados pessoais — LGPD). Sempre scoped por tenant.
model Client {
  id        String    @id @default(cuid())
  tenantId  String
  name      String    @db.VarChar(120)
  email     String?   @db.VarChar(255)
  phone     String    @db.VarChar(32)
  notes     String?   @db.Text
  /// Consentimento para lembretes (WhatsApp/e-mail)
  marketingOptIn Boolean @default(false)
  /// Pontos de fidelidade acumulados (atendimentos concluídos)
  loyaltyPoints  Int     @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("clients")
}

enum AppointmentStatus {
  /// Aguardando sinal PIX (quando depositCents > 0) — Fase 7
  PENDING_PAYMENT
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Agendamento. startsAt/endsAt SEMPRE em UTC.
model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  professionalId String
  clientId       String
  serviceId      String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  /// Token secreto do link de auto-gestão do cliente (confirmar/cancelar/remarcar)
  manageToken    String            @unique @default(cuid())
  /// Observação do cliente no momento do booking
  customerNotes  String?           @db.VarChar(500)
  /// Snapshot do preço no momento do agendamento (evita divergência se serviço mudar)
  priceCentsSnapshot   Int
  durationMinutesSnapshot Int
  cancelledAt    DateTime?
  cancelReason   String?           @db.VarChar(255)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional User       @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  review       Review?
  pixCharge    PixCharge?

  @@index([tenantId, startsAt])
  @@index([professionalId, startsAt])
  @@index([clientId])
  /// Impede dois bookings exatamente no mesmo start para o mesmo profissional
  /// (camada 1). Overlap parcial é tratado com transaction + lock na Fase 3.
  @@unique([professionalId, startsAt])
  @@map("appointments")
}

/// Assinatura do SaaS (estrutura pronta; cobrança real na Fase 7).
model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  plan                 PlanCode           @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  /// Limite de agendamentos/mês no plano (null = ilimitado)
  monthlyBookingLimit  Int?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// Catálogo de planos (features/limites). Preços finais ficam em env/Stripe Price IDs.
model PlanDefinition {
  id                  String   @id @default(cuid())
  code                PlanCode @unique
  name                String   @db.VarChar(64)
  description         String?  @db.VarChar(255)
  /// Placeholder; a aplicação lê PRICE_* do env / Stripe — não hardcodar preço de venda aqui
  monthlyBookingLimit Int?
  maxProfessionals    Int      @default(1)
  whatsappReminders   Boolean  @default(false)
  pixDepositEnabled   Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("plan_definitions")
}

/// Outbox / trilha de jobs assíncronos (e-mail, WhatsApp). Usado na Fase 4.
model NotificationJob {
  id          String                @id @default(cuid())
  tenantId    String
  appointmentId String?
  type        NotificationJobType
  channel     NotificationChannel
  payload     Json
  status      NotificationJobStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  scheduledFor DateTime             @default(now())
  processedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, scheduledFor])
  @@index([tenantId])
  @@map("notification_jobs")
}

enum NotificationJobType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLED
  WHATSAPP_REMINDER_LINK
  PASSWORD_RESET
  WAITLIST_SLOT_OPEN
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// =============================================================================
// Fase 8 — Paridade de mercado: PIX, lista de espera, avaliações
// =============================================================================

enum PixChargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

/// Cobrança PIX de sinal (Mercado Pago). 1:1 com o agendamento.
model PixCharge {
  id            String          @id @default(cuid())
  tenantId      String
  appointmentId String          @unique
  provider      String          @default("mercadopago") @db.VarChar(32)
  /// ID do pagamento no provedor (para conciliar via webhook)
  providerRef   String?         @unique @db.VarChar(64)
  amountCents   Int
  status        PixChargeStatus @default(PENDING)
  /// Código copia-e-cola do PIX
  copyPaste     String?         @db.Text
  /// QR Code em base64 (imagem)
  qrCodeBase64  String?         @db.Text
  expiresAt     DateTime?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("pix_charges")
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
}

/// Lista de espera: cliente quer um dia sem vaga; é avisado quando abre horário.
model WaitlistEntry {
  id             String         @id @default(cuid())
  tenantId       String
  serviceId      String?
  professionalId String?
  /// Data civil desejada (YYYY-MM-DD no fuso do tenant)
  dateKey        String         @db.VarChar(10)
  clientName     String         @db.VarChar(120)
  clientPhone    String         @db.VarChar(32)
  clientEmail    String?        @db.VarChar(255)
  status         WaitlistStatus @default(WAITING)
  notifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dateKey, status])
  @@map("waitlist_entries")
}

/// Avaliação pós-atendimento (via link de gestão do cliente). 1:1 com agendamento.
model Review {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String   @unique
  /// 1 a 5 estrelas
  rating        Int
  comment       String?  @db.VarChar(500)
  clientName    String   @db.VarChar(120)
  /// Exibida na página pública somente se aprovada (default true; dono pode ocultar)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPublished])
  @@map("reviews")
}
